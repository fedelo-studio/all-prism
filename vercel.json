{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/px?entry=1"
    },
    {
      "source": "/b",
      "destination": "/api/px?entry=1"
    },
    {
      "source": "/build-from-unity/:path*",
      "destination": "https://staging.wrapper.all-prism.app/build-from-unity/:path*"
    },
    {
      "source": "/_h/:key/:path*",
      "destination": "/api/px?u=:key/:path*"
    },
    {
      "source": "/:path((?!api/|_h/).+)",
      "destination": "/api/px?u=w/:path"
    }
  ]
}
